// Cloudflare configuration for New Way's.
// Before the first deployment: create the D1 database and the R2 bucket, then paste the database id below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-ways-website",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // The free temporary address stays on as a back door for testing; it forwards visitors once REDIRECT_TEST_ADDRESS is 1.
  "workers_dev": true,
  // The permanent address and www are attached to this Worker in the Cloudflare dashboard (Domains & Routes).
  // No "routes" are listed here on purpose, so deployments leave those domains exactly as they are.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "new-ways",
      "database_id": "1f1dc3bc-d799-4d4b-abd4-c931701a1d55",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "new-ways-media" }
  ],
  // New Way's Community live comments: one Durable Object (Cloudflare's free plan includes them; on the free plan they
  // simply stop for the rest of the day if a free limit is ever reached, they never charge). It holds the visitors' live
  // connections and "hibernates" between messages, so idle connections use no running time.
  "durable_objects": {
    "bindings": [
      { "name": "COMMUNITY_LIVE", "class_name": "CommunityLive" }
    ]
  },
  "migrations": [
    { "tag": "community-live-1", "new_sqlite_classes": ["CommunityLive"] }
  ],
  "vars": {
    // The real public address. Every other address (like the temporary test address) is kept out of Google.
    "SITE_URL": "https://newwaysmediumshipdevelopmentcentre.com"
  },
  // Sign-in and spam-protection keys are added in the Cloudflare dashboard as secrets (docs/workos-setup.md),
  // so deployments never overwrite them.
  "keep_vars": true,
  // Daily housekeeping at 03:17 UTC, every hour at 7 minutes past for bookings, and on Wednesdays at 17:00 and 18:00 UTC
  // (one of them is 6pm in the UK, summer or winter) for the 6pm Wednesday email. Cron Triggers are free.
  "triggers": { "crons": ["17 3 * * *", "7 * * * *", "0 17,18 * * 3"] },
  "observability": { "enabled": true }
}
